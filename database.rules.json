{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "game": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "questions": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "$questionId": {
        ".validate": "!newData.exists() || (newData.hasChildren(['text', 'optionA', 'optionB']) && newData.child('text').isString())"
      }
    },

    "participants": {
      ".read": "auth != null",

      "$participantId": {
        ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && (auth.uid === $participantId || !data.child('coupleId').exists() || !root.child('couples').child(data.child('coupleId').val()).exists()) && (data.exists() || root.child('game').child('status').val() === 'WAITING' || !root.child('game').child('status').exists() || root.child('game').child('allowLateJoin').val() === true))",
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 'status']) && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40)",

        "name": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val() || root.child('admins').child(auth.uid).val() === true)"
        },
        "status": {
          ".validate": "newData.val() === 'AVAILABLE' || newData.val() === 'PAIRED'"
        },
        "coupleId": {
          ".validate": "newData.isString() && (!data.exists() || root.child('admins').child(auth.uid).val() === true || !root.child('couples').child(data.val()).exists())"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "couples": {
      ".read": "auth != null",

      "$coupleId": {
        ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && !data.exists() && newData.child('memberIds').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['coupleName', 'participant1', 'participant2', 'memberIds', 'score'])",

        "score": {
          ".validate": "newData.isNumber() && (root.child('admins').child(auth.uid).val() === true || newData.val() === 0)"
        },
        "wins": {
          ".validate": "newData.isNumber() && (root.child('admins').child(auth.uid).val() === true || newData.val() === 0)"
        },
        "totalResponseTime": {
          ".validate": "newData.isNumber() && (root.child('admins').child(auth.uid).val() === true || newData.val() === 0)"
        },
        "coupleName": {
          ".validate": "newData.isString() && newData.val().length <= 90"
        }
      }
    },

    "rounds": {
      ".write": "root.child('admins').child(auth.uid).val() === true",

      "$roundId": {
        ".read": "root.child('admins').child(auth.uid).val() === true",

        "questionId": { ".read": "auth != null" },
        "questionNumber": { ".read": "auth != null" },
        "startedAt": { ".read": "auth != null" },
        "timeLimit": { ".read": "auth != null" },
        "status": { ".read": "auth != null" },
        "summary": { ".read": "auth != null" },
        "results": { ".read": "auth != null" },

        "progress": {
          ".read": "auth != null",
          "$coupleId": {
            "$participantId": {
              ".write": "auth != null && auth.uid === $participantId && !data.exists() && root.child('participants').child(auth.uid).child('coupleId').val() === $coupleId && root.child('game').child('status').val() === 'QUESTION_ACTIVE' && root.child('game').child('currentRoundId').val() === $roundId",
              ".validate": "newData.val() === true"
            }
          }
        },

        "responses": {
          "$participantId": {
            ".read": "auth != null && auth.uid === $participantId",
            ".write": "auth != null && auth.uid === $participantId && !data.exists() && root.child('game').child('status').val() === 'QUESTION_ACTIVE' && root.child('game').child('currentRoundId').val() === $roundId",
            ".validate": "newData.hasChildren(['answer', 'answeredAt', 'coupleId']) && (newData.child('answer').val() === 'A' || newData.child('answer').val() === 'B') && newData.child('answeredAt').val() === now && newData.child('coupleId').val() === root.child('participants').child(auth.uid).child('coupleId').val()"
          }
        }
      }
    }
  }
}
